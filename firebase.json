{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firebase-debug.log",
      ".firebase/**",
      ".gitignore",
      ".vscode/**",
      "backend/**",
      "__pycache__/**",
      "**/*.py",
      "**/*.pyc",
      "**/*.bat",
      "**/*.cmd",
      "**/*.ps1",
      "dev-server.js",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
